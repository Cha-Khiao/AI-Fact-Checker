# ==============================================================================
# AI Fact-Checker — Environment Configuration Template (.env.example)
# ==============================================================================

# --- Backend: LLM Model Configuration ---
AI_MODEL="google/gemini-2.5-flash"
LLM_BACKEND="openrouter"

# --- Backend: Required API Keys ---
# 1. OpenRouter (LLM Planner & Analyzer): https://openrouter.ai
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"

# 2. Serper (Google Live Search): https://serper.dev
SERPER_API_KEY="your_serper_key_here"

# 3. Exa.ai (Semantic Web Search): https://exa.ai
EXA_API_KEY="your_exa_key_here"

# --- Backend: Optional Telemetry & Performance ---
GSHEETS_WEBHOOK_URL=""
FACTCHECK_DEADLINE_SECONDS=45
PORT=8000

# --- Frontend: Next.js API Target (Set in web/.env.local or Vercel Settings) ---
# In Development: http://localhost:8000
# In Production: https://your-backend-api.onrender.com
NEXT_PUBLIC_API_URL="http://localhost:8000"
